---
/**
 * A weekly digest: every story disclosed in one ISO week, most severe first,
 * with a data-built summary. Static and linkable, for sharing a week at once.
 */
import Base from "@/layouts/Base.astro";
import StoryList from "@/components/StoryList.astro";
import ShareBar from "@/components/ShareBar.astro";
import Cover from "@/components/Cover.astro";
import { SeverityMeter } from "@/components/SeverityMeter";
import { weeks, digestSentence, type Week } from "@/lib/hubs";
import { hubImage } from "@/lib/hub-cards";
import { SEVERITY_ORDER } from "@/data/schema";
import { SEVERITY_META } from "@/data/categories";
import { SITE, abs, u } from "@/site";

export function getStaticPaths() {
  const all = weeks();
  return all.map((w, i) => ({ params: { key: w.key }, props: { week: w, newer: all[i - 1] ?? null, older: all[i + 1] ?? null } }));
}

interface Props { week: Week; newer: Week | null; older: Week | null }
const { week, newer, older } = Astro.props;
const path = `/week/${week.key}/`;
const fmt = (d: string, year = false) => new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", ...(year ? { year: "numeric" } : {}), timeZone: "UTC" });
const range = `${fmt(week.start)} to ${fmt(week.end, true)}`;
const summary = digestSentence(week.items, `in week ${week.week} of ${week.year} (${range})`);
const top = week.items[0];
const bySev = SEVERITY_ORDER.map((s) => ({ s, items: week.items.filter((i) => i.severity === s) })).filter((g) => g.items.length);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `AI security, week ${week.week} ${week.year}`,
  description: summary,
  url: abs(path),
  isPartOf: { "@id": abs("/#website") },
  temporalCoverage: `${week.start}/${week.end}`,
  mainEntity: { "@type": "ItemList", itemListElement: week.items.map((it, i) => ({ "@type": "ListItem", position: i + 1, url: abs(`/items/${it.id}/`), name: it.title })) },
};
const mono = "font-mono text-[10.5px] uppercase tracking-[0.06em]";
---

<Base title={`AI security news, week ${week.week} of ${week.year}`} description={summary} path={path} image={hubImage(`week/${week.key}`)} jsonLd={[jsonLd]}>
  <nav aria-label="Breadcrumb" class={`pt-6 ${mono} text-muted-foreground`}><a href={u("/week/")} class="hover:text-ink">Weekly digests</a></nav>
  <header class="border-b border-line pb-8 pt-4">
    <p class={`${mono} text-acid`}>Week {week.week} · {range}</p>
    <h1 class="mt-2 font-heading text-[clamp(36px,5vw,64px)] font-semibold leading-none text-white">AI security this week</h1>
    <p class="mt-5 max-w-3xl border-l-2 border-acid pl-4 text-[16px] leading-relaxed">{summary}</p>
  </header>

  <div class="grid gap-10 pt-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-14">
    <div class="min-w-0 space-y-12">
      <section aria-labelledby="top-h" class="grid gap-6 rounded-sm border border-line bg-panel p-4 sm:grid-cols-[1fr_1.2fr] sm:p-6">
        <a href={u(`/items/${top.id}/`)}><Cover item={top} ratio="16/10" size="lg" /></a>
        <div>
          <p class={`flex items-center gap-3 ${mono} text-muted-foreground`}><span id="top-h">Top story</span><SeverityMeter severity={top.severity} /></p>
          <a href={u(`/items/${top.id}/`)} class="mt-2 block font-heading text-3xl font-semibold leading-tight text-white hover:underline decoration-acid underline-offset-4">{top.title}</a>
          <p class="mt-2 text-muted-foreground">{top.explainer.tagline}</p>
          {top.explainer.whatToDo && <p class="mt-3 text-sm"><span class={`${mono} text-acid`}>What to do · </span>{top.explainer.whatToDo}</p>}
        </div>
      </section>
      {bySev.map((g) => (
        <section aria-labelledby={`sev-${g.s}`}>
          <h2 id={`sev-${g.s}`} class="mb-3 flex items-baseline justify-between font-heading text-3xl">{SEVERITY_META[g.s].label} <span class={`${mono} text-muted-foreground`}>{g.items.length}</span></h2>
          <StoryList items={g.items} />
        </section>
      ))}
    </div>
    <aside class="space-y-8 lg:sticky lg:top-6 lg:self-start">
      <ShareBar url={abs(path)} title={`AI security, week ${week.week} ${week.year}`} context={`A weekly digest of AI security stories on ${SITE.name}, ${range}.`} question="Summarise this week's AI security news for a security team: what needs action now, and what is background?" />
      <nav aria-label="Other weeks" class={`flex justify-between gap-4 ${mono}`}>
        {older ? <a href={u(`/week/${older.key}/`)} class="text-muted-foreground hover:text-acid">← Week {older.week}</a> : <span />}
        {newer && <a href={u(`/week/${newer.key}/`)} class="text-muted-foreground hover:text-acid">Week {newer.week} →</a>}
      </nav>
      <p class={mono}><a href={u("/week/rss.xml")} class="text-muted-foreground hover:text-acid">[ Weekly RSS ]</a></p>
    </aside>
  </div>
</Base>
