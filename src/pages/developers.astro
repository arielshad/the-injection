---
import Base from "@/layouts/Base.astro";
import Prose from "@/components/Prose.astro";
import { allItems } from "@/data/feed";
import { SITE, abs } from "@/site";
const sample = allItems()[0];
const endpoints = [
  ["/llms.txt", "text/plain", "Index for language models: what the site is, when to use it, and the latest stories."],
  ["/llms-full.txt", "text/plain", "Every story in full, as one Markdown document."],
  ["/feed.json", "application/feed+json", "JSON Feed 1.1 of the latest 100 stories, with severity, CVE, CVSS, affected products and sources under _injection."],
  ["/rss.xml", "application/rss+xml", "RSS 2.0 of the latest 50 stories."],
  ["/index.md", "text/markdown", "The homepage as Markdown."],
  ["/tools.json", "application/json", "The open-source AI security tools directory: name, repo, kind (scanner, guardrail, red-team, eval, sandbox), license, maintainer and what it covers."],
  ["/items/<id>.md", "text/markdown", "One story as Markdown: severity, credits, explainer, FAQ and numbered sources."],
  ["/items/<id>/", "text/html", "One story as HTML, with NewsArticle, BreadcrumbList and FAQPage JSON-LD."],
  ["/sitemap-index.xml", "application/xml", "Every page, with lastmod."],
];
---

<Base title="Developers and agents" description={`${SITE.name} data for agents and developers: llms.txt, JSON Feed, RSS and Markdown for every AI security story.`} path="/developers/">
  <Prose kicker="Developers" title={`${SITE.name} for developers and agents`}>
    <p>{SITE.name} publishes its whole AI security feed in machine-readable formats. Everything is static, public and free to read: no key, no account, no rate limit beyond your HTTP client's manners. The feed refreshes every hour.</p>
    <h2>Endpoints</h2>
    <table>
      <thead><tr><th>Path</th><th>Type</th><th>What it is</th></tr></thead>
      <tbody>{endpoints.map(([p, t, d]) => <tr><td><code>{p}</code></td><td><code>{t}</code></td><td>{d}</td></tr>)}</tbody>
    </table>
    <h2>Examples</h2>
    <pre><code>{`# The latest critical and high severity stories
curl -s ${abs("/feed.json")} | jq '.items[] | select(._injection.severity == "critical" or ._injection.severity == "high") | {title, url, cve: ._injection.cve}'

# One story as Markdown
curl -s ${abs(`/items/${sample?.id ?? "example"}.md`)}`}</code></pre>
    <h2>Fields</h2>
    <p>Each item in <code>feed.json</code> carries <code>_injection.severity</code> (critical, high, medium, low, info), <code>_injection.categories</code>, <code>_injection.affected</code> (products and ecosystems), <code>_injection.cve</code> and <code>_injection.cvss</code> when an official source published them, <code>_injection.links</code>, the sources the story was verified against, <code>_injection.benchmarks</code> (measured results exactly as the source published them, each with its source link) and <code>_injection.video</code> for talks. Researchers are in <code>authors</code>.</p>
    <h2>Using it well</h2>
    <ul>
      <li>Cite the original research. Each story names who found the issue and links the primary source; quote them, not us.</li>
      <li>Severity is our editorial rating for defenders, not a CVSS score. Where an official CVSS exists it is in its own field.</li>
      <li>Poll no more than every hour; nothing changes between the hourly sweeps.</li>
    </ul>
  </Prose>
</Base>
