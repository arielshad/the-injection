---
import Base from "@/layouts/Base.astro";
import Cover from "@/components/Cover.astro";
import FeedList from "@/components/FeedList.astro";
import ExposureStrips from "@/components/ExposureStrips";
import { SeverityMeter } from "@/components/SeverityMeter";
import { SplitFlapDisplay } from "@/components/ui/split-flap-display";
import { allItems, categoryCounts } from "@/data/feed";
import { CATEGORY_ORDER, SEVERITY_ORDER } from "@/data/schema";
import { CATEGORY_META } from "@/data/categories";
import { SITE, abs, u } from "@/site";
import { exposureStrips } from "@/lib/exposure";

const items = allItems();
const rank = (s: string) => SEVERITY_ORDER.indexOf(s as never);

// Lead: the most severe of the newest dozen, preferring one with a real image.
const lead = [...items.slice(0, 12)].sort((a, b) => rank(a.severity) - rank(b.severity) || Number(!!b.image) - Number(!!a.image))[0];

const pad = (n: number) => String(n).padStart(2, "0");
const board = [
  { value: pad(items.length), label: "Stories tracked" },
  { value: pad(items.filter((i) => i.severity === "critical" || i.severity === "high").length), label: "High or critical" },
  { value: pad(items.filter((i) => i.cve).length), label: "CVEs published" },
  { value: pad(new Set(items.map((i) => i.org)).size), label: "Sources" },
];

// The advisory header: the facts a defender scans for, in a fixed order.
const advisory = lead
  ? [
      ...(lead.affected?.length ? [["Affects", lead.affected.slice(0, 4).join(", ")]] : []),
      ...(lead.cve ? [["CVE", `${lead.cve}${lead.cvss !== undefined ? ` · CVSS ${lead.cvss}` : ""}`]] : []),
      ...(lead.quickFacts ?? []).filter((f) => !/found by|severity|cve|cvss|affected/i.test(f.label)).slice(0, 3).map((f) => [f.label, f.value]),
      ["Credit", lead.credits.map((c) => c.name).join(", ")],
    ]
  : [];

const counts = categoryCounts();
const categories = CATEGORY_ORDER.map((id) => ({ id, label: CATEGORY_META[id].label, count: counts[id] ?? 0 })).filter((c) => c.count > 0);
const exposure = exposureStrips(items);
const head = "flex items-baseline justify-between font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${SITE.name}: latest AI security news`,
  itemListElement: items.slice(0, 30).map((it, i) => ({ "@type": "ListItem", position: i + 1, url: abs(`/items/${it.id}/`), name: it.title })),
};
---

<Base jsonLd={[itemList]}>
  <section aria-label="This week in numbers" class="mt-6 hidden grid-cols-2 gap-px md:grid overflow-hidden rounded-sm border border-line bg-line lg:grid-cols-4">
    {board.map((b, i) => (
      <div class="bg-panel p-4 sm:p-5">
        <SplitFlapDisplay client:visible text={b.value} columns={2} size="md" showIndicators={false} staggerDelay={80} flipSpeed={45} className="!rounded-sm !bg-none !p-0 !shadow-none !border-0" />
        <p class="mt-3 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted-foreground">{b.label}</p>
      </div>
    ))}
  </section>

  {lead && (
    <section aria-label="Lead story" class="mt-6 grid grid-cols-1 gap-6 rounded-sm border border-line bg-panel p-4 sm:p-6 lg:grid-cols-[1.25fr_1fr] lg:gap-8">
      <a href={u(`/items/${lead.id}/`)} class="block"><Cover item={lead} ratio="16/10" size="xl" eager /></a>
      <div class="flex min-w-0 flex-col">
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted-foreground">
          <SeverityMeter severity={lead.severity} size="md" />
          <span>{CATEGORY_META[lead.categories[0]].label}</span>
          <time datetime={lead.date}>{lead.date}</time>
        </p>
        <h2 class="mt-3 font-heading text-[clamp(30px,3.6vw,48px)] font-semibold leading-[1.02] text-white">
          <a href={u(`/items/${lead.id}/`)} class="hover:underline decoration-acid decoration-2 underline-offset-4">{lead.title}</a>
        </h2>
        <p class="mt-3 text-[16px] leading-relaxed text-muted-foreground">{lead.explainer.tagline}</p>
        <dl class="mt-5 border-t border-line pt-4 font-mono text-[11.5px] leading-[1.9]">
          {advisory.map(([k, v]) => (
            <div class="grid grid-cols-[6rem_minmax(0,1fr)] gap-3 sm:grid-cols-[7.5rem_minmax(0,1fr)]"><dt class="uppercase text-muted-foreground">{k}</dt><dd class="text-ink [overflow-wrap:anywhere]">{v}</dd></div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {/* Thirty day cells are too small to read or tap on a phone: there it is a link to the full page. */}
  <a href={u("/exposure/")} class="mt-6 flex items-center justify-between gap-4 rounded-sm border border-line bg-panel px-4 py-3 font-mono text-[11px] uppercase tracking-[0.06em] text-ink hover:border-acid md:hidden">
    30-day exposure by ecosystem <span aria-hidden="true" class="text-acid">→</span>
  </a>

  <section aria-labelledby="exposure-h" class="mt-10 hidden md:block">
    <div class={head}><h2 id="exposure-h">30-day exposure by ecosystem</h2><span>hover a day for its stories · <a href={u("/exposure/")} class="text-ink hover:text-acid">Full view →</a></span></div>
    <div class="mt-3 rounded-sm border border-line bg-panel px-4 py-1">
      <ExposureStrips client:only="react" end={exposure.end} strips={exposure.strips} />
      <noscript><p class="py-3 font-mono text-[11px] text-muted-foreground">The 30-day exposure strips need JavaScript. The same stories are in the feed below.</p></noscript>
    </div>
    <p class="mt-2 flex gap-4 font-mono text-[10.5px] text-muted-foreground">
      <span><span class="mr-1.5 inline-block size-2 bg-sev-critical align-middle"></span>High / critical</span>
      <span><span class="mr-1.5 inline-block size-2 bg-sev-medium align-middle"></span>Medium</span>
      <span><span class="mr-1.5 inline-block size-2 bg-sev-low align-middle"></span>Low / info</span>
    </p>
  </section>

  <div class="mt-12">
    <FeedList items={items} categories={categories} severities={SEVERITY_ORDER} />
  </div>
</Base>
