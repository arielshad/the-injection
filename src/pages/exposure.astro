---
/**
 * 30-day exposure by ecosystem, on its own page. The homepage shows the strips
 * on wider screens only; here they get the full width, and every story behind
 * them is listed in plain HTML, so the page works by touch and without
 * JavaScript (the strips' hover cards need a pointer).
 */
import Base from "@/layouts/Base.astro";
import ExposureStrips from "@/components/ExposureStrips";
import { SeverityMeter } from "@/components/SeverityMeter";
import { allItems } from "@/data/feed";
import { CATEGORY_META } from "@/data/categories";
import { exposureGroups, exposureStrips } from "@/lib/exposure";
import { fmtDate } from "@/lib/slim";
import { SITE, u } from "@/site";

const items = allItems();
const exposure = exposureStrips(items);
const { start, end, groups } = exposureGroups(items);
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const head = "flex items-baseline justify-between font-mono text-[11px] uppercase tracking-[0.06em] text-muted-foreground";
---

<Base title="Exposure by ecosystem" description={`30 days of AI security stories on ${SITE.name}, by ecosystem: coding agents, MCP and plugins, packages and models, assistants and apps, labs and evals.`} path="/exposure/">
  <header class="py-10">
    <p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Exposure</p>
    <h1 class="mt-2 font-heading text-5xl font-semibold text-white sm:text-6xl">30-day exposure by ecosystem</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/80">One cell per day for the 30 days to {fmtDate(end)}, coloured by the most severe story that day. A story can touch more than one ecosystem.</p>
  </header>

  <section aria-labelledby="strips-h">
    <div class={head}><h2 id="strips-h">Last 30 days</h2><span class="hidden sm:inline">hover a day for its stories</span></div>
    <div class="mt-3 rounded-sm border border-line bg-panel px-4 py-1">
      <ExposureStrips client:only="react" end={exposure.end} strips={exposure.strips} />
      <noscript><p class="py-3 font-mono text-[11px] text-muted-foreground">The strips need JavaScript. Every story behind them is listed below.</p></noscript>
    </div>
    <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10.5px] text-muted-foreground">
      <span><span class="mr-1.5 inline-block size-2 bg-sev-critical align-middle"></span>High / critical</span>
      <span><span class="mr-1.5 inline-block size-2 bg-sev-medium align-middle"></span>Medium</span>
      <span><span class="mr-1.5 inline-block size-2 bg-sev-low align-middle"></span>Low / info</span>
    </p>
  </section>

  <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-x-12">
    {groups.map((g) => (
      <section aria-labelledby={`${slug(g.name)}-h`}>
        <h2 id={`${slug(g.name)}-h`} class="flex items-baseline justify-between gap-4 border-b border-line pb-2 font-heading text-2xl text-white">
          {g.name}
          <span class="shrink-0 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{g.items.length} {g.items.length === 1 ? "story" : "stories"}</span>
        </h2>
        {g.items.length === 0 ? (
          <p class="py-4 text-sm text-muted-foreground">Nothing from {fmtDate(start)} to {fmtDate(end)}.</p>
        ) : (
          <ol class="divide-y divide-border">
            {g.items.map((it) => (
              <li>
                <a href={u(`/items/${it.id}/`)} class="group block py-3">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10.5px] uppercase tracking-[0.04em] text-muted-foreground">
                    <SeverityMeter severity={it.severity} />
                    <span>{CATEGORY_META[it.categories[0]].label}</span>
                    <time datetime={it.date}>{it.date}</time>
                  </span>
                  <span class="mt-1 block font-heading text-[17px] font-semibold leading-snug text-white group-hover:underline decoration-acid">{it.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))}
  </div>
</Base>
