---
import Base from "@/layouts/Base.astro";
import { GLOSSARY, GLOSSARY_GROUPS } from "@/data/glossary";
import { TOPIC_TAGS } from "@/data/tags";
import { topicItems } from "@/lib/hubs";
import { hubImage } from "@/lib/hub-cards";
import { SITE, abs, u } from "@/site";

const grouped = new Set(GLOSSARY_GROUPS.flatMap((g) => g.tags));
const groups = [...GLOSSARY_GROUPS, { label: "More terms", tags: TOPIC_TAGS.filter((t) => !grouped.has(t)) }].filter((g) => g.tags.length);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": abs("/learn/#set"),
  name: `${SITE.name} AI security glossary`,
  description: "Plain-English definitions of AI security terms, each linked to real, sourced cases.",
  url: abs("/learn/"),
  hasDefinedTerm: TOPIC_TAGS.map((t) => ({ "@type": "DefinedTerm", name: GLOSSARY[t].term, url: abs(`/learn/${t}/`), description: GLOSSARY[t].short })),
};
const mono = "font-mono text-[10.5px] uppercase tracking-[0.06em]";
---

<Base title="AI security glossary" description="Plain-English definitions of prompt injection, tool poisoning, sandbox escapes, MCP and other AI security terms, each with the real cases behind it." path="/learn/" image={hubImage("learn")} jsonLd={[jsonLd]}>
  <header class="border-b border-line py-10">
    <p class={`${mono} text-muted-foreground`}>Learn</p>
    <h1 class="mt-2 font-heading text-5xl font-semibold text-white sm:text-6xl">AI security glossary</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{TOPIC_TAGS.length} terms, each defined in plain English, with how it works, how to defend against it and every story on {SITE.name} that shows it in the real world.</p>
  </header>
  {groups.map((grp) => (
    <section class="mt-10" aria-label={grp.label}>
      <h2 class="border-b border-line pb-2 font-heading text-3xl">{grp.label}</h2>
      <ul class="mt-4 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
        {grp.tags.map((t) => (
          <li>
            <a href={u(`/learn/${t}/`)} class="group block">
              <span class="flex items-baseline justify-between gap-3"><span class="font-heading text-xl font-semibold text-white group-hover:underline decoration-acid underline-offset-4">{GLOSSARY[t].term}</span><span class="font-mono text-[11px] text-muted-foreground">{topicItems(t).length}</span></span>
              <span class="mt-1 line-clamp-3 block text-sm leading-relaxed text-muted-foreground">{GLOSSARY[t].short}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
