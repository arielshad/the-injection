---
/**
 * One glossary term: an answer-first definition, how it works, how to defend,
 * and every story filed under the tag. Tag chips on stories link here.
 */
import Base from "@/layouts/Base.astro";
import StoryList from "@/components/StoryList.astro";
import ShareBar from "@/components/ShareBar.astro";
import { GLOSSARY, termInText, whatIs } from "@/data/glossary";
import { TOPIC_TAGS, type TopicTag } from "@/data/tags";
import { topicItems, topProducts } from "@/lib/hubs";
import { hubImage } from "@/lib/hub-cards";
import { SITE, abs, u } from "@/site";

export function getStaticPaths() {
  return TOPIC_TAGS.map((tag) => ({ params: { tag }, props: { tag } }));
}

interface Props { tag: TopicTag }
const { tag } = Astro.props;
const g = GLOSSARY[tag];
const items = topicItems(tag);
const path = `/learn/${tag}/`;
const plain = termInText(tag);
const question = whatIs(tag);
const products = topProducts(items, 5);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "@id": abs(`${path}#term`),
    name: g.term,
    ...(g.aka?.length ? { alternateName: g.aka } : {}),
    description: g.short,
    url: abs(path),
    inDefinedTermSet: { "@type": "DefinedTermSet", "@id": abs("/learn/#set"), name: `${SITE.name} AI security glossary`, url: abs("/learn/") },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      { "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: g.short } },
      { "@type": "Question", name: `How does ${plain} work?`, acceptedAnswer: { "@type": "Answer", text: g.how } },
      { "@type": "Question", name: `How do you defend against ${plain}?`, acceptedAnswer: { "@type": "Answer", text: g.defend } },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.name, item: abs("/") },
      { "@type": "ListItem", position: 2, name: "Glossary", item: abs("/learn/") },
      { "@type": "ListItem", position: 3, name: g.term, item: abs(path) },
    ],
  },
];
const mono = "font-mono text-[10.5px] uppercase tracking-[0.06em]";
---

<Base title={`${question} Definition, examples, defenses`} description={g.short} path={path} image={hubImage(`learn/${tag}`)} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class={`pt-6 ${mono} text-muted-foreground`}><a href={u("/learn/")} class="hover:text-ink">Glossary</a></nav>
  <article class="grid gap-10 pb-6 pt-4 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-14">
    <div class="min-w-0">
      <header class="border-b border-line pb-8">
        <h1 class="font-heading text-[clamp(36px,5vw,64px)] font-semibold leading-none text-white">{g.term}</h1>
        {g.aka?.length && <p class={`mt-3 ${mono} text-muted-foreground`}>Also called: {g.aka.join(" · ")}</p>}
        <p id="definition" class="mt-6 border-l-2 border-acid pl-4 text-xl leading-relaxed">{g.short}</p>
      </header>
      <section class="mt-10" aria-labelledby="how-h">
        <h2 id="how-h" class="font-heading text-3xl">How it works</h2>
        <p class="mt-3 max-w-prose text-[1.05rem] leading-[1.75] text-ink/80">{g.how}</p>
      </section>
      <section class="mt-10" aria-labelledby="defend-h">
        <h2 id="defend-h" class="font-heading text-3xl">How to defend</h2>
        <p class="mt-3 max-w-prose text-[1.05rem] leading-[1.75] text-ink/80">{g.defend}</p>
      </section>
      <section class="mt-14" aria-labelledby="cases-h">
        <h2 id="cases-h" class="mb-3 flex items-baseline justify-between font-heading text-3xl">Real cases <span class={`${mono} text-muted-foreground`}>{items.length} {items.length === 1 ? "story" : "stories"}</span></h2>
        {items.length ? <StoryList items={items} /> : <p class="text-muted-foreground">No story is filed under this term yet. New ones land here automatically.</p>}
      </section>
    </div>
    <aside class="space-y-8 lg:sticky lg:top-6 lg:self-start">
      <div>
        <p class={`${mono} text-muted-foreground`}>Related terms</p>
        <ul class="mt-2 space-y-1 text-sm">
          {g.see.map((t) => <li><a href={u(`/learn/${t}/`)} class="underline decoration-ink/30 underline-offset-2 hover:decoration-acid">{GLOSSARY[t].term}</a></li>)}
        </ul>
      </div>
      {products.length > 0 && (
        <div>
          <p class={`${mono} text-muted-foreground`}>Products hit</p>
          <ul class="mt-2 space-y-1 text-sm">
            {products.map((p) => <li class="flex justify-between gap-3"><a href={u(`/products/${p.product.slug}/`)} class="underline decoration-ink/30 underline-offset-2 hover:decoration-acid">{p.product.name}</a><span class="font-mono text-[11px] text-muted-foreground">{p.count}</span></li>)}
          </ul>
        </div>
      )}
      <ShareBar url={abs(path)} title={question} context={`A glossary entry on ${SITE.name} with real, sourced cases.`} question={`Explain ${plain} using the real cases listed there, and what I should do about it.`} />
    </aside>
  </article>
</Base>
