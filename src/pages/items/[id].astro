---
import { u } from "@/site";
import Base from "@/layouts/Base.astro";
import SeverityBadge from "@/components/SeverityBadge.astro";
import { allItems, relatedItems } from "@/data/feed";
import { CATEGORY_META, SEVERITY_META } from "@/data/categories";
import type { Item } from "@/data/schema";
import { SITE, abs } from "@/site";
import { fmtDate } from "@/lib/slim";
import { domainOf } from "@/lib/severity";
import Cover from "@/components/Cover.astro";
import { ReadingProgress } from "@/components/ui/reading-progress";

export function getStaticPaths() {
  return allItems().map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props { item: Item }
const { item } = Astro.props;
const path = `/items/${item.id}/`;
const primary = CATEGORY_META[item.categories[0]];
const related = relatedItems(item, 4);
const words = [item.summary, ...Object.values(item.explainer), ...(item.faq ?? []).flatMap((f) => [f.q, f.a])].join(" ").split(/\s+/).length;

const sections = [
  { id: "what-happened", label: "What happened", body: item.explainer.whatHappened },
  { id: "how-it-works", label: "How it works", body: item.explainer.howItWorks },
  { id: "who-is-affected", label: "Who is affected", body: item.explainer.whoIsAffected },
  ...(item.explainer.whatToDo ? [{ id: "what-to-do", label: "What to do", body: item.explainer.whatToDo }] : []),
];

const facts = [
  { label: "Severity", value: SEVERITY_META[item.severity].label },
  { label: "Published by", value: item.org },
  { label: "Disclosed", value: fmtDate(item.date) },
  ...(item.cve ? [{ label: "CVE", value: item.cve }] : []),
  ...(item.cvss !== undefined ? [{ label: "CVSS", value: String(item.cvss) }] : []),
  ...(item.affected?.length ? [{ label: "Affects", value: item.affected.join(", ") }] : []),
  ...(item.quickFacts ?? []),
];

const article = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "@id": abs(`${path}#article`),
  headline: item.title,
  description: item.summary,
  datePublished: `${item.date}T12:00:00Z`,
  dateModified: item.publishDate,
  url: abs(path),
  mainEntityOfPage: abs(path),
  articleSection: primary.label,
  keywords: [...item.tags, ...(item.affected ?? [])].join(", "),
  about: (item.affected ?? []).map((name) => ({ "@type": "Thing", name })),
  author: item.credits.map((c) => ({
    "@type": "Person",
    name: c.name,
    ...(c.org ? { affiliation: { "@type": "Organization", name: c.org } } : {}),
    ...(c.url ? { url: c.url } : {}),
  })),
  publisher: { "@id": abs("/#org") },
  isBasedOn: item.url,
  citation: item.links.map((l) => l.url),
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#tagline", "#what-happened"] },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: abs("/") },
    { "@type": "ListItem", position: 2, name: primary.label, item: abs(`/category/${item.categories[0]}/`) },
    { "@type": "ListItem", position: 3, name: item.title, item: abs(path) },
  ],
};
const faqLd = item.faq?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: item.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    }
  : null;
---

<Base
  title={item.title.length > 46 ? item.title.slice(0, 46).replace(/\s+\S*$/, "") : item.title}
  description={item.summary}
  path={path}
  ogType="article"
  publishedTime={`${item.date}T12:00:00Z`}
  jsonLd={[article, breadcrumb, ...(faqLd ? [faqLd] : [])]}
>
  <div class="sticky top-0 z-30 -mx-4 bg-paper/90 px-4 py-2 backdrop-blur sm:-mx-8 sm:px-8">
    <ReadingProgress client:idle words={words} label="Reading progress" doneLabel="Done" />
  </div>
  <nav aria-label="Breadcrumb" class="pt-6 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
    <a href={u("/")} class="hover:text-ink">Latest</a>
    <span class="mx-1.5">/</span>
    <a href={u(`/category/${item.categories[0]}/`)} class="hover:text-ink">{primary.label}</a>
  </nav>

  <article class="grid gap-10 pb-6 pt-6 lg:grid-cols-[1fr_18rem] lg:gap-14">
    <div>
      <header class="border-b border-line pb-8">
        <div class="flex flex-wrap items-center gap-2">
          <SeverityBadge severity={item.severity} size="md" />
          {item.categories.map((c) => (
            <a href={u(`/category/${c}/`)} class="rounded-[3px] border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider hover:border-acid">{CATEGORY_META[c].label}</a>
          ))}
        </div>
        <h1 class="mt-5 font-heading text-[clamp(34px,4.6vw,60px)] font-semibold leading-[1.0] text-white">{item.title}</h1>
        <p id="tagline" class="mt-5 text-xl leading-relaxed text-ink/80">{item.explainer.tagline}</p>
        <p class="mt-6 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
          <time datetime={item.date}>{fmtDate(item.date)}</time> · {item.org} · Research by{" "}
          {item.credits.map((c, i) => (
            <>
              {i > 0 && ", "}
              {c.url ? <a href={c.url} rel="noopener" class="text-ink underline decoration-ink/30 underline-offset-2 hover:decoration-ink">{c.name}</a> : <span class="text-ink">{c.name}</span>}
              {c.org && c.org !== item.org && <span> ({c.org})</span>}
            </>
          ))}
        </p>
      </header>
      <Cover item={item} ratio="16/9" size="xl" class="mt-8" eager />

      <p class="mt-8 border-l-2 border-acid pl-4 text-lg leading-relaxed">{item.summary}</p>
      <ul class="mt-5 flex flex-wrap items-center gap-2" aria-label="Sources">
        {item.links.slice(0, 3).map((l) => (
          <li>
            <a href={l.url} rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-[12.5px] hover:border-acid">
              <span class="font-mono text-[10.5px] uppercase tracking-wider text-muted-foreground">{domainOf(l.url)}</span>
              <span class="max-w-[16rem] truncate">{l.label}</span>
            </a>
          </li>
        ))}
        {item.links.length > 3 && <li><a href="#sources-h" class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground hover:text-ink">+{item.links.length - 3} sources</a></li>}
      </ul>

      {sections.map((s, i) => (
        <section id={s.id} class="mt-10" aria-labelledby={`${s.id}-h`}>
          <h2 id={`${s.id}-h`} class="flex items-baseline gap-3 font-heading text-3xl">
            <span class="font-mono text-xs text-acid">0{i + 1}</span>{s.label}
          </h2>
          <p class="mt-3 max-w-prose text-[1.05rem] leading-[1.75] text-ink/80">{s.body}</p>
        </section>
      ))}

      {item.faq && item.faq.length > 0 && (
        <section class="mt-14" aria-labelledby="faq-h">
          <h2 id="faq-h" class="border-b border-line pb-2 font-heading text-3xl">Questions people ask</h2>
          <dl class="divide-y divide-border">
            {item.faq.map((f) => (
              <div class="py-5">
                <dt class="font-medium">{f.q}</dt>
                <dd class="mt-2 max-w-prose leading-relaxed text-muted-foreground">{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <section class="mt-14" aria-labelledby="sources-h">
        <h2 id="sources-h" class="flex items-baseline justify-between border-b border-line pb-2 font-heading text-3xl">Sources <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{item.links.length} links, all fetched</span></h2>
        <ol class="mt-3 space-y-2">
          {item.links.map((l, i) => (
            <li class="flex items-baseline gap-3 text-sm">
              <span class="grid size-5 shrink-0 place-items-center rounded-sm bg-panel-2 font-mono text-[10px] text-acid">{i + 1}</span>
              <span class="shrink-0 rounded-full bg-muted px-2 py-0.5 font-mono text-[10.5px] text-muted-foreground">{domainOf(l.url)}</span>
              <a href={l.url} rel="noopener" class="underline decoration-ink/30 underline-offset-2 hover:decoration-acid">{l.label}</a>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="space-y-8 lg:sticky lg:top-6 lg:self-start">
      <div class="rounded-md border border-line bg-card">
        <p class="border-b border-line px-4 py-2 font-mono text-[11px] uppercase tracking-wider">Case file</p>
        <dl class="divide-y divide-border text-sm">
          {facts.map((f) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-2 px-4 py-2.5">
              <dt class="text-muted-foreground">{f.label}</dt>
              <dd class="font-medium">{f.value}</dd>
            </div>
          ))}
        </dl>
        <a href={item.url} rel="noopener" class="block border-t border-line bg-acid px-4 py-2.5 text-center font-mono text-[11px] uppercase tracking-wider text-black hover:bg-white">Read the original ↗</a>
      </div>
      <nav aria-label="On this page" class="hidden lg:block">
        <p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">On this page</p>
        <ol class="mt-2 space-y-1 border-l border-border" data-toc>
          {sections.map((s, i) => (
            <li><a href={`#${s.id}`} data-toc-link={s.id} class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-muted-foreground hover:text-ink"><span class="mr-2 font-mono text-[10.5px]">0{i + 1}</span>{s.label}</a></li>
          ))}
          {item.faq && item.faq.length > 0 && <li><a href="#faq-h" data-toc-link="faq-h" class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-muted-foreground hover:text-ink">Questions</a></li>}
          <li><a href="#sources-h" data-toc-link="sources-h" class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-muted-foreground hover:text-ink">Sources</a></li>
        </ol>
      </nav>
      {item.tags.length > 0 && (
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Tags</p>
          <ul class="mt-2 flex flex-wrap gap-1.5">
            {item.tags.map((t) => <li class="rounded-sm border border-line px-2 py-0.5 font-mono text-[10.5px] text-muted-foreground">{t}</li>)}
          </ul>
        </div>
      )}
    </aside>
  </article>

  {related.length > 0 && (
    <section class="mt-10 border-t border-line pt-6" aria-labelledby="related-h">
      <h2 id="related-h" class="font-heading text-3xl">Related</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((r) => (
          <li>
            <SeverityBadge severity={r.severity} />
            <a href={u(`/items/${r.id}/`)} class="mt-2 block font-heading text-xl leading-tight hover:underline">{r.title}</a>
            <p class="mt-1 font-mono text-[10.5px] uppercase tracking-wider text-muted-foreground">{r.org}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  // Highlight the section being read in the contents rail.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].map((a) => [a.dataset.tocLink!, a]));
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      links.forEach((a) => a.classList.remove("!border-acid", "!text-ink"));
      links.get(e.target.id)?.classList.add("!border-acid", "!text-ink");
    }
  }, { rootMargin: "-20% 0px -70% 0px" });
  targets.forEach((t) => io.observe(t));
</script>
