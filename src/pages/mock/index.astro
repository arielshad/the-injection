---
/**
 * MOCK of the proposed editorial direction, on the real feed data.
 * Not linked from the site. Fonts: Bricolage Grotesque (display, condensed),
 * Source Serif 4 (body), IBM Plex Mono (labels).
 */
import "@/styles/global.css";
import Cover from "@/components/mock/Cover.astro";
import { Marquee } from "@/components/ui/marquee";
import { allItems } from "@/data/feed";
import { CATEGORY_META } from "@/data/categories";
import { SEVERITY_ORDER } from "@/data/schema";
import { SEV_GLYPH, SEV_TEXT } from "@/lib/severity";
import { TOPIC } from "@/lib/topic";
import { fmtDate } from "@/lib/slim";
import images from "@/data/mock-images.json";

const items = allItems();
const rank = (s: string) => SEVERITY_ORDER.indexOf(s as never);
const bySev = [...items].sort((a, b) => rank(a.severity) - rank(b.severity) || (a.date < b.date ? 1 : -1));
const lead = items.find((i) => i.id === "air-plugin4shell") ?? bySev[0];
const rest = items.filter((i) => i.id !== lead.id);
const seconds = rest.filter((i) => (images as Record<string, string>)[i.id]).slice(0, 2);
const used = new Set([lead.id, ...seconds.map((s) => s.id)]);
const row3 = rest.filter((i) => !used.has(i.id)).slice(0, 3);
row3.forEach((i) => used.add(i.id));
const darkBand = bySev.filter((i) => (i.severity === "high" || i.severity === "critical") && (i.cve || i.affected?.length)).slice(0, 4);
const bento = rest.filter((i) => !used.has(i.id)).slice(0, 4);
const top5 = bySev.slice(0, 5);
const label = (c: string) => CATEGORY_META[c as keyof typeof CATEGORY_META].label;
const counts = { total: items.length, high: items.filter((i) => i.severity === "high").length, vendors: new Set(items.map((i) => i.org)).size };
const kicker = "font-plex text-[10.5px] font-semibold uppercase tracking-[0.14em]";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MOCK: The Injection, editorial direction</title>
  <meta name="robots" content="noindex" />
  <style>
    @keyframes rise { from { opacity: 0; transform: translateY(14px); filter: blur(6px) } to { opacity: 1; transform: none; filter: none } }
    .rise { animation: rise .7s cubic-bezier(.2,.7,.2,1) both }
    .mark { background: linear-gradient(transparent 58%, oklch(0.86 0.17 95 / .85) 58% 92%, transparent 92%); }
  </style>
</head>
<body class="bg-paper font-serif4 text-ink antialiased">
  <!-- Masthead -->
  <header class="mx-auto max-w-7xl px-4 sm:px-8">
    <div class={`flex items-center justify-between border-b border-ink/15 py-2 text-muted-foreground ${kicker}`}>
      <span>Wed 7 Oct 2026 · Updated 2h ago</span>
      <span class="hidden gap-5 sm:flex"><span><b class="text-ink">{counts.total}</b> stories</span><span class="text-sev-high">◆ <b>{counts.high}</b> high</span><span><b class="text-ink">{counts.vendors}</b> vendors</span></span>
      <span>RSS · JSON · llms.txt</span>
    </div>
    <div class="flex items-end justify-between gap-6 pb-4 pt-6">
      <h1 class="font-display text-[clamp(56px,11vw,152px)] font-extrabold uppercase leading-[0.8] tracking-[-0.02em] [font-stretch:78%]">The Injection<span class="text-sev-critical">.</span></h1>
      <p class="hidden max-w-[17rem] pb-2 text-right text-[15px] italic leading-snug text-ink/70 lg:block">AI security, verified and explained. The attacks, the flaws, the supply chain and the people who found them.</p>
    </div>
    <div class="h-[5px] bg-ink"></div><div class="mt-[3px] h-px bg-ink"></div>
    <nav class={`flex gap-6 overflow-x-auto py-3 ${kicker} [scrollbar-width:none]`}>
      {["Latest", "Vulnerability", "Attack", "Supply chain", "Research", "Incident", "Tool", "Benchmark", "Lab safety"].map((n, i) => <a class:list={["whitespace-nowrap", i === 0 && "text-sev-critical"]}>{n}</a>)}
    </nav>
  </header>

  <!-- Ticker (21st.dev Marquee) -->
  <div class="bg-ink text-paper">
    <div class="mx-auto flex max-w-7xl items-center px-4 sm:px-8">
      <span class={`shrink-0 bg-sev-critical px-3 py-2.5 text-white ${kicker}`}>● Live</span>
      <Marquee pauseOnHover repeat={2} className="py-0 [--duration:70s] [--gap:3rem] [mask-image:linear-gradient(to_right,transparent,black_4%,black_96%,transparent)]">
        {bySev.slice(0, 7).map((it) => <span class="flex items-center gap-2 whitespace-nowrap py-2.5 font-display text-[15px] font-semibold"><span class={SEV_TEXT[it.severity]}>{SEV_GLYPH[it.severity]}</span>{it.title}</span>)}
      </Marquee>
    </div>
  </div>

  <main class="mx-auto max-w-7xl px-4 sm:px-8">
    <!-- 1. Image-led lead + 2 secondaries -->
    <section class="grid gap-8 border-b-2 border-ink py-8 lg:grid-cols-12">
      <article class="rise lg:col-span-8">
        <Cover item={lead} ratio="16/9" size="xl" />
        <p class={`mt-5 ${kicker} text-sev-high`}>{SEV_GLYPH[lead.severity]} {lead.severity} · {label(lead.categories[0])} · {fmtDate(lead.date)}</p>
        <h2 class="mt-2 font-display text-[clamp(38px,5.4vw,76px)] font-extrabold leading-[0.92] tracking-[-0.035em] [font-stretch:80%]">{lead.title}</h2>
        <p class="mt-4 max-w-3xl text-xl leading-relaxed text-ink/85">A git branch named after a commit hash lets an attacker <span class="mark">swap a pinned, reviewed plugin for malicious code</span> during auto-update.</p>
        <p class={`mt-4 ${kicker} text-muted-foreground`}>By <span class="text-ink">{lead.credits.map((c) => c.name).join(", ")}</span> · {lead.org}</p>
      </article>
      <div class="grid gap-8 lg:col-span-4 lg:border-l lg:border-ink/20 lg:pl-8">
        {seconds.map((it, i) => (
          <article class="rise" style={`animation-delay:${120 + i * 120}ms`}>
            <Cover item={it} ratio="16/10" size="md" />
            <p class={`mt-3 ${kicker} ${SEV_TEXT[it.severity]}`}>{SEV_GLYPH[it.severity]} {it.severity} · <span class="text-muted-foreground">{it.org}</span></p>
            <h3 class="mt-1.5 font-display text-[26px] font-bold leading-[1.02] tracking-[-0.02em] [font-stretch:85%]">{it.title}</h3>
          </article>
        ))}
      </div>
    </section>

    <!-- 2. Row of three -->
    <section class="py-10">
      <div class="mb-5 flex items-baseline justify-between border-b border-ink pb-2"><h2 class="font-display text-3xl font-extrabold uppercase tracking-[-0.02em] [font-stretch:75%]">Just in</h2><span class={`${kicker} text-muted-foreground`}>All stories →</span></div>
      <div class="grid gap-8 md:grid-cols-3">
        {row3.map((it, i) => (
          <article class="rise" style={`animation-delay:${i * 100}ms`}>
            <Cover item={it} ratio="3/2" size="md" />
            <p class={`mt-3 ${kicker} ${SEV_TEXT[it.severity]}`}>{SEV_GLYPH[it.severity]} {it.severity} · <span class="text-muted-foreground">{label(it.categories[0])}</span></p>
            <h3 class="mt-1.5 font-display text-[24px] font-bold leading-[1.04] tracking-[-0.02em] [font-stretch:85%]">{it.title}</h3>
            <p class="mt-2 text-[15.5px] leading-relaxed text-ink/75">{it.explainer.tagline}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <!-- 3. Dark band: high severity, generated CVE covers -->
  <section class="bg-ink py-12 text-paper">
    <div class="mx-auto max-w-7xl px-4 sm:px-8">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="font-display text-[clamp(34px,5vw,64px)] font-extrabold uppercase leading-[0.85] tracking-[-0.04em] [font-stretch:75%]">Patch this week<span class="text-sev-critical">.</span></h2>
        <p class={`${kicker} text-paper/60`}>Generated covers · no photo needed</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {darkBand.map((it) => (
          <article>
            <Cover item={it} ratio="4/5" size="lg" forceGenerated />
            <h3 class="mt-3 font-display text-[19px] font-semibold leading-tight">{it.title}</h3>
            <p class={`mt-1 ${kicker} text-paper/55`}>{it.org}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-7xl px-4 sm:px-8">
    <section class="grid gap-10 py-12 lg:grid-cols-12">
      <!-- 4. Bento quick hits (21st.dev Bento-style grid) -->
      <div class="lg:col-span-8">
        <div class="mb-5 border-b border-ink pb-2"><h2 class="font-display text-3xl font-extrabold uppercase tracking-[-0.02em] [font-stretch:75%]">Quick hits</h2></div>
        <div class="grid auto-rows-[150px] grid-cols-2 gap-3 md:grid-cols-4 [grid-auto-flow:dense]">
          {bento.map((it, i) => {
            const t = TOPIC[it.categories[0]];
            const big = i === 0;
            return big ? (
              <article class="relative col-span-2 row-span-2 overflow-hidden"><Cover item={it} ratio="fill" size="lg" class="absolute inset-0" hideText /><h3 class="absolute bottom-0 p-4 font-display text-[26px] font-bold leading-[1.02] text-white [text-shadow:0_1px_12px_rgba(0,0,0,.5)]">{it.title}</h3></article>
            ) : (
              <article class:list={["flex flex-col justify-between p-4", i === 3 && "col-span-2"]} style={`background:${t.bg};color:${t.ink}`}>
                <p class={kicker}>{SEV_GLYPH[it.severity]} {label(it.categories[0])}</p>
                <h3 class="font-display text-[19px] font-bold leading-[1.05] [font-stretch:85%]">{it.title}</h3>
              </article>
            );
          })}
        </div>
      </div>
      <!-- 5. Top five, giant numerals -->
      <aside class="lg:col-span-4">
        <div class="mb-2 border-b border-ink pb-2"><h2 class="font-display text-3xl font-extrabold uppercase tracking-[-0.02em] [font-stretch:75%]">Most severe</h2></div>
        <ol>
          {top5.map((it, i) => (
            <li class="grid grid-cols-[3.2rem_1fr] items-start gap-3 border-b border-ink/15 py-3.5">
              <span class="font-display text-[52px] font-extrabold leading-[0.8] text-ink/15 [font-stretch:75%]">{i + 1}</span>
              <div><p class={`${kicker} ${SEV_TEXT[it.severity]}`}>{SEV_GLYPH[it.severity]} {it.severity}</p><h3 class="mt-1 font-display text-[18px] font-semibold leading-tight">{it.title}</h3></div>
            </li>
          ))}
        </ol>
      </aside>
    </section>
  </main>

  <footer class="mt-6 bg-ink py-10 text-paper">
    <div class="mx-auto max-w-7xl px-4 sm:px-8">
      <p class="font-display text-[clamp(48px,9vw,120px)] font-extrabold uppercase leading-[0.8] tracking-[-0.02em] [font-stretch:78%]">The Injection<span class="text-sev-critical">.</span></p>
      <p class={`mt-6 ${kicker} text-paper/50`}>Mock · Bricolage Grotesque, Source Serif 4, IBM Plex Mono · covers generated or duotoned from source images</p>
    </div>
  </footer>
</body>
</html>
