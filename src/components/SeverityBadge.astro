---
import type { Severity } from "@/data/schema";
interface Props { severity: Severity; size?: "sm" | "md" }
const { severity, size = "sm" } = Astro.props;
const tone: Record<Severity, string> = {
  critical: "bg-sev-critical text-white",
  high: "bg-sev-high text-white",
  medium: "bg-sev-medium text-ink",
  low: "bg-sev-low text-white",
  info: "bg-sev-info text-white",
};
---
<span
  class:list={[
    "inline-flex items-center rounded-[3px] font-mono font-semibold uppercase tracking-wider",
    size === "sm" ? "px-1.5 py-0.5 text-[10px]" : "px-2 py-1 text-xs",
    tone[severity],
  ]}
>{severity}</span>
