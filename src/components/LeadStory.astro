---
import { u } from "@/site";
import type { Item } from "@/data/schema";
import { CATEGORY_META } from "@/data/categories";
import SeverityBadge from "@/components/SeverityBadge.astro";
import { fmtDate } from "@/lib/slim";

interface Props { lead: Item; seconds: Item[] }
const { lead, seconds } = Astro.props;
---

<section aria-label="Top stories" class="grid gap-8 border-b border-ink py-8 lg:grid-cols-[1.6fr_1fr] lg:gap-12">
  <article>
    <div class="flex items-center gap-3">
      <SeverityBadge severity={lead.severity} size="md" />
      <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
        {CATEGORY_META[lead.categories[0]].label} · <time datetime={lead.date}>{fmtDate(lead.date)}</time>
      </span>
    </div>
    <h2 class="mt-4 font-heading text-4xl leading-[1.05] tracking-tight sm:text-[3.4rem]">
      <a href={u(`/items/${lead.id}/`)} class="decoration-sev-critical decoration-2 underline-offset-[6px] hover:underline">{lead.title}</a>
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/80">{lead.explainer.tagline}</p>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{lead.summary}</p>
    <p class="mt-5 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
      Research by <span class="text-ink">{lead.credits.map((c) => c.name).join(", ")}</span>
      {lead.affected && lead.affected.length > 0 && <> · Affects {lead.affected.slice(0, 3).join(", ")}</>}
    </p>
  </article>
  <div class="divide-y divide-border border-t border-border lg:border-l lg:border-t-0 lg:pl-8">
    {seconds.map((it) => (
      <article class="py-4 first:pt-0 lg:first:pt-0">
        <div class="flex items-center gap-2">
          <SeverityBadge severity={it.severity} />
          <span class="font-mono text-[10.5px] uppercase tracking-wider text-muted-foreground">{it.org}</span>
        </div>
        <h3 class="mt-2 font-heading text-2xl leading-tight">
          <a href={u(`/items/${it.id}/`)} class="decoration-sev-critical decoration-1 underline-offset-4 hover:underline">{it.title}</a>
        </h3>
        <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{it.explainer.tagline}</p>
      </article>
    ))}
  </div>
</section>
