---
import { u } from "@/site";
import { SITE } from "@/site";
import { CATEGORY_ORDER, SEVERITY_ORDER } from "@/data/schema";
import { CATEGORY_META, SEVERITY_META } from "@/data/categories";
import { SEV_GLYPH, SEV_TEXT } from "@/lib/severity";
import { feed } from "@/data/feed";

const year = new Date().getUTCFullYear();
const updated = new Date(feed.generatedAt).toUTCString().replace(/:\d\d GMT$/, " UTC");
// The last sentence of each blurb is the action: "Act today", "Plan a fix".
const action = (blurb: string) => blurb.trim().replace(/\.$/, "").split(". ").pop();
const head = "border-b-[3px] border-ink pb-2 font-mono text-[11px] uppercase tracking-wider";
---

<footer class="mt-24">
  <div class="h-[3px] bg-ink"></div>
  <div class="mt-[2px] h-px bg-ink"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-4">
    <div>
      <p class="font-heading text-4xl leading-none">The <em>Injection</em><span class="text-sev-critical">.</span></p>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{SITE.tagline} An agent checks advisories, research groups and papers every six hours. Nothing goes in unless every link was fetched and the researchers are credited.</p>
    </div>
    <nav aria-label="Sections">
      <p class={head}>Sections</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        {CATEGORY_ORDER.map((c) => <li><a class="hover:text-sev-critical" href={u(`/category/${c}/`)}>{CATEGORY_META[c].label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class={head}>Severity index</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        {SEVERITY_ORDER.map((s) => (
          <li class="flex gap-2">
            <span class={SEV_TEXT[s]} aria-hidden="true">{SEV_GLYPH[s]}</span>
            <span>{SEVERITY_META[s].label}</span>
            <span class="text-muted-foreground">{action(SEVERITY_META[s].blurb)}</span>
          </li>
        ))}
      </ul>
    </div>
    <nav aria-label="Read it your way">
      <p class={head}>Read it your way</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li><a class="hover:text-sev-critical" href={u("/about/")}>About and method</a></li>
        <li><a class="hover:text-sev-critical" href={u("/rss.xml")}>RSS feed</a></li>
        <li><a class="hover:text-sev-critical" href={u("/feed.json")}>JSON feed</a></li>
        <li><a class="hover:text-sev-critical" href={u("/llms.txt")}>llms.txt</a></li>
      </ul>
    </nav>
  </div>
  <p class="mx-auto max-w-6xl border-t border-border px-4 py-5 font-mono text-[10.5px] uppercase tracking-wider text-muted-foreground sm:px-6">
    © {year} {SITE.name} · Set in Instrument Serif, Inter and JetBrains Mono · Feed updated {updated}
  </p>
</footer>
