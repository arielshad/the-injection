---
import { u } from "@/site";
import { SITE } from "@/site";
import { CATEGORY_ORDER, SEVERITY_ORDER } from "@/data/schema";
import { CATEGORY_META, SEVERITY_META } from "@/data/categories";
import { SeverityMeter } from "@/components/SeverityMeter";
import { feed } from "@/data/feed";

const year = new Date().getUTCFullYear();
const updated = new Date(feed.generatedAt).toUTCString().replace(/:\d\d GMT$/, " UTC");
// The last sentence of each blurb is the action: "Act today", "Plan a fix".
const action = (blurb: string) => blurb.trim().replace(/\.$/, "").split(". ").pop();
const head = "border-b border-line pb-2 font-mono text-[10.5px] font-semibold uppercase tracking-[0.14em] text-muted-foreground";
---

<footer class="mt-24 border-t border-line bg-panel text-ink">
  <div class="mx-auto max-w-7xl px-4 pt-14 sm:px-8">
    <p class="font-heading text-[clamp(48px,9vw,128px)] font-extrabold uppercase leading-[0.8] tracking-[-0.02em] ">The Injection<span class="text-acid">_</span></p>
    <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted-foreground">{SITE.tagline} An agent checks advisories, research groups and papers every six hours. Nothing goes in unless every link was fetched and the researchers are credited.</p>
  </div>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-3 sm:px-8">
    <nav aria-label="Sections">
      <p class={head}>Sections</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-[15px]">
        {CATEGORY_ORDER.map((c) => <li><a class="hover:text-acid" href={u(`/category/${c}/`)}>{CATEGORY_META[c].label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class={head}>Severity index</p>
      <ul class="mt-3 space-y-1.5 text-[15px]">
        {SEVERITY_ORDER.map((s) => (
          <li class="flex items-center gap-3">
            <span class="w-16 shrink-0"><SeverityMeter severity={s} /></span>
            <span class="text-muted-foreground">{action(SEVERITY_META[s].blurb)}</span>
          </li>
        ))}
      </ul>
    </div>
    <nav aria-label="Read it your way">
      <p class={head}>Read it your way</p>
      <ul class="mt-3 space-y-1.5 text-[15px]">
        <li><a class="hover:text-acid" href={u("/about/")}>About and method</a></li>
        <li><a class="hover:text-acid" href={u("/rss.xml")}>RSS feed</a></li>
        <li><a class="hover:text-acid" href={u("/feed.json")}>JSON feed</a></li>
        <li><a class="hover:text-acid" href={u("/llms.txt")}>llms.txt</a></li>
        <li><a class="hover:text-acid" href={u("/developers/")}>Developers and agents</a></li>
        <li><a class="hover:text-acid" href={u("/contact/")}>Contact</a></li>
        <li><a class="hover:text-acid" href={SITE.feedbackUrl} rel="noopener">Feedback on GitHub</a></li>
        <li><a class="hover:text-acid" href={u("/privacy/")}>Privacy</a></li>
      </ul>
    </nav>
  </div>
  <p class="mx-auto max-w-7xl border-t border-line px-4 py-5 font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted-foreground sm:px-8">
    © {year} {SITE.name} · Set in Hanken Grotesk and Martian Mono · Feed updated {updated}
  </p>
</footer>
