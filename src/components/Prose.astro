---
/** Shared layout for the plain text pages (about, contact, privacy, developers). */
interface Props { kicker: string; title: string }
const { kicker, title } = Astro.props;
---
<article class="prose-page mx-auto max-w-2xl py-12">
  <p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{kicker}</p>
  <h1 class="mt-2 font-heading text-5xl font-semibold text-white sm:text-6xl">{title}</h1>
  <slot />
</article>
<style is:global>
  .prose-page h2 { margin-top: 3rem; font-family: var(--font-heading); font-size: 1.875rem; font-weight: 600; color: #fff; }
  .prose-page p, .prose-page ul, .prose-page ol, .prose-page pre { margin-top: 1rem; line-height: 1.75; }
  .prose-page ul { list-style: disc; padding-left: 1.25rem; }
  .prose-page ol { list-style: decimal; padding-left: 1.25rem; }
  .prose-page li + li { margin-top: .5rem; }
  .prose-page a { color: var(--acid); text-decoration: underline; text-underline-offset: 3px; }
  .prose-page code { font-family: var(--font-mono); font-size: .85em; color: var(--ink); background: var(--panel-2); padding: .1em .35em; border-radius: 2px; }
  .prose-page pre { overflow-x: auto; background: var(--panel); border: 1px solid var(--line); padding: 1rem; font-family: var(--font-mono); font-size: 12px; }
  .prose-page pre code { background: none; padding: 0; }
  .prose-page table { margin-top: 1rem; width: 100%; font-size: 14px; border-collapse: collapse; }
  .prose-page th, .prose-page td { border-bottom: 1px solid var(--line); padding: .5rem .5rem .5rem 0; text-align: left; vertical-align: top; }
  .prose-page td code { overflow-wrap: anywhere; }
  .prose-page th { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--muted-foreground); font-weight: 500; }
</style>
