---
/**
 * An item's cover: the source's own image, or, when there is none, a cover
 * generated from the item (src/lib/cover.ts): a colour field and pattern
 * drawn from the id's hash, with the CVE or product set large on top.
 */
import type { Item } from "@/data/schema";
import { CATEGORY_META } from "@/data/categories";
import { SeverityMeter } from "@/components/SeverityMeter";
import { coverArt } from "@/lib/cover";

interface Props { item: Item; ratio?: string; size?: "xl" | "lg" | "md" | "sm" | "xs"; class?: string; forceGenerated?: boolean; hideText?: boolean; eager?: boolean; chip?: boolean }
const { item, ratio = "16/9", size = "md", class: cls = "", forceGenerated = false, hideText = false, eager = false, chip = true } = Astro.props;

const img = forceGenerated ? undefined : item.image?.url;
const art = coverArt(item);
const fontPx = { xl: 64, lg: 48, md: 36, sm: 22, xs: 13 }[size];
const label = CATEGORY_META[item.categories[0]].label;
---

<div class:list={["relative overflow-hidden", cls]} style={`${ratio === "fill" ? "height:100%" : `aspect-ratio:${ratio}`};background:${art.bg}`}>
  <Fragment set:html={art.svg} />
  {!hideText && (
    <div class="absolute inset-0 flex items-end p-[6%]" style={`color:${art.ink}`}>
      <span class="font-heading font-bold leading-[0.95] tracking-[-0.02em]" style={`font-size:clamp(14px, ${fontPx / 14}vw, ${fontPx}px)`}>{art.text}</span>
    </div>
  )}
  {/* The source image covers the generated art; if it fails to load (hotlink blocks), the art shows through. */}
  {img && <img src={img} alt={item.image?.alt ?? ""} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 size-full object-cover saturate-[.9]" onerror="this.remove()" />}
  {chip && (
    <div class="absolute left-0 top-0 flex items-center gap-2 p-2.5">
      <span class="rounded-sm bg-black/60 px-1.5 py-1 backdrop-blur"><SeverityMeter severity={item.severity} /></span>
      {size !== "xs" && size !== "sm" && <span class="rounded-sm bg-black/45 px-1.5 py-1 font-mono text-[10px] uppercase tracking-[0.06em] text-white/85 backdrop-blur">{label}</span>}
    </div>
  )}
</div>
