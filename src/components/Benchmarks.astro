---
/**
 * Benchmark bars: one chart per measure the source publishes. Horizontal bars
 * from one baseline, <= 24px thick (16px here), square at the baseline and
 * rounded 4px at the data end. The story's own row is the acid accent and is
 * also labelled in text, so identity never rests on colour; every other row
 * is a neutral grey (context, not a category). Values sit at the bar tip in
 * text ink. The markup is a real <table>, so the numbers are readable without
 * the bars. Validated: acid vs grey on the dark surface, CVD delta E 37.6,
 * contrast >= 3:1.
 */
import type { Benchmark } from "@/data/schema";
import { domainOf } from "@/lib/severity";

interface Props { benchmarks: Benchmark[] }
const { benchmarks } = Astro.props;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
---

<section id="benchmarks" class="mt-12" aria-labelledby="benchmarks-h">
  <h2 id="benchmarks-h" class="border-b border-line pb-2 font-heading text-3xl">Measured results</h2>
  {benchmarks.map((b) => {
    const max = b.max ?? 100;
    const unit = b.unit ?? "%";
    return (
      <figure class="mt-6">
        <figcaption>
          <p class="font-medium">{b.name}</p>
          {b.note && <p class="mt-0.5 text-sm text-muted-foreground">{b.note}</p>}
        </figcaption>
        <table class="mt-3 w-full border-collapse text-sm">
          <thead class="sr-only">
            <tr><th scope="col">Result</th><th scope="col">Score</th></tr>
          </thead>
          <tbody>
            {b.results.map((r) => (
              <tr title={`${r.name}: ${fmt(r.score)}${unit}${r.highlight ? " (this story)" : ""}`} class="group">
                <th scope="row" class:list={["w-[38%] max-w-[14rem] py-1.5 pr-3 text-left align-middle font-normal leading-tight", r.highlight ? "font-semibold text-ink" : "text-muted-foreground"]}>
                  {r.name}
                  {r.highlight && <span class="ml-1.5 whitespace-nowrap font-mono text-[10px] uppercase tracking-wider text-acid">this story</span>}
                </th>
                <td class="py-1.5 align-middle">
                  <div class="flex items-center gap-2">
                    <div class="relative h-4 min-w-0 flex-1" aria-hidden="true">
                      <div
                        class:list={["h-4 rounded-r-[4px] transition-opacity group-hover:opacity-90", r.highlight ? "bg-acid" : "bg-[#7C858C]"]}
                        style={`width:${Math.max((r.score / max) * 100, 0.5)}%`}
                      />
                    </div>
                    <span class="w-14 shrink-0 text-right font-mono text-[12px] tabular-nums text-ink">{fmt(r.score)}{unit}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-2 font-mono text-[10.5px] uppercase tracking-wider text-muted-foreground">
          Scale 0 to {fmt(max)}{unit} · Source: <a href={b.source} rel="noopener" class="hover:text-ink">{domainOf(b.source)}</a>, as published
        </p>
      </figure>
    );
  })}
</section>
