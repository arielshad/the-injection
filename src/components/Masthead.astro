---
import { u } from "@/site";
import { SITE } from "@/site";
import { CATEGORY_ORDER } from "@/data/schema";
import { CATEGORY_META } from "@/data/categories";
import { feed } from "@/data/feed";
import SweepClock from "@/components/SweepClock";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(BASE.length) || "/";
const isHome = path === "/";

const mono = "font-mono text-[11px] tracking-[0.02em]";
const wordmark = "font-heading text-[26px] font-extrabold uppercase leading-none tracking-[0.01em] text-white sm:text-[30px]";
---

<header class="mx-auto max-w-7xl px-4 sm:px-8">
  <div class="flex items-center justify-between gap-4 border-b border-line py-4">
    <a href={u("/")} aria-label={`${SITE.name} home`}>
      {isHome ? <h1 class={wordmark}>The Injection<span class="text-acid">_</span></h1> : <span class={wordmark}>The Injection<span class="text-acid">_</span></span>}
    </a>
    <p class="hidden md:block"><SweepClock client:load lastSweep={feed.generatedAt} /></p>
    <p class={`text-muted-foreground ${mono}`}>
      <a class="hover:text-acid" href={u("/rss.xml")}>[ RSS ]</a> <a class="hover:text-acid" href={u("/feed.json")}>[ JSON ]</a> <a class="hidden hover:text-acid sm:inline" href={u("/llms.txt")}>[ llms.txt ]</a>
    </p>
  </div>
  <nav aria-label="Sections" class="border-b border-line">
    <ul class={`flex gap-6 overflow-x-auto py-3 uppercase text-muted-foreground ${mono} [scrollbar-width:none]`}>
      <li><a href={u("/")} class:list={["whitespace-nowrap hover:text-ink", isHome && "text-acid"]}>Latest</a></li>
      {CATEGORY_ORDER.map((c) => (
        <li><a href={u(`/category/${c}/`)} class:list={["whitespace-nowrap hover:text-ink", path.startsWith(`/category/${c}/`) && "text-acid"]}>{CATEGORY_META[c].label}</a></li>
      ))}
      <li class="ml-auto"><a href={u("/about/")} class:list={["whitespace-nowrap hover:text-ink", path === "/about/" && "text-acid"]}>About</a></li>
    </ul>
  </nav>
</header>
