---
import { SITE } from "@/site";
import { CATEGORY_ORDER } from "@/data/schema";
import { CATEGORY_META } from "@/data/categories";

const isHome = Astro.url.pathname === "/";
const edition = new Date().toLocaleDateString("en-US", {
  weekday: "long", year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
});
const current = Astro.url.pathname;
---

<header class="border-b border-ink/90">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground sm:px-6">
    <span>{edition}</span>
    <span class="hidden sm:inline">Sourced. Credited. Explained.</span>
    <a href="/rss.xml" class="hover:text-ink">RSS</a>
  </div>
  <div class="mx-auto max-w-6xl border-t border-border px-4 sm:px-6">
    <div class="flex items-end justify-between gap-6 py-5 sm:py-7">
      <a href="/" class="group block leading-none" aria-label={`${SITE.name} home`}>
        {isHome ? (
          <h1 class="font-heading text-5xl tracking-tight sm:text-7xl">
            The <em class="italic">Injection</em><span class="text-sev-critical">.</span>
          </h1>
        ) : (
          <span class="font-heading text-4xl tracking-tight sm:text-5xl">
            The <em class="italic">Injection</em><span class="text-sev-critical">.</span>
          </span>
        )}
      </a>
      <p class="hidden max-w-xs pb-1 text-right text-sm leading-snug text-muted-foreground md:block">
        {SITE.tagline} Prompt injection, agent supply chain, jailbreaks and the research behind them.
      </p>
    </div>
  </div>
  <nav aria-label="Sections" class="border-t border-ink/90">
    <ul class="mx-auto flex max-w-6xl gap-5 overflow-x-auto px-4 py-2.5 font-mono text-[11px] uppercase tracking-wider sm:px-6 [scrollbar-width:none]">
      <li><a href="/" class:list={["whitespace-nowrap hover:text-sev-critical", current === "/" && "text-sev-critical"]}>Latest</a></li>
      {CATEGORY_ORDER.map((c) => (
        <li>
          <a
            href={`/category/${c}/`}
            class:list={["whitespace-nowrap hover:text-sev-critical", current.startsWith(`/category/${c}/`) && "text-sev-critical"]}
          >{CATEGORY_META[c].label}</a>
        </li>
      ))}
      <li class="ml-auto"><a href="/about/" class="whitespace-nowrap hover:text-sev-critical">About</a></li>
    </ul>
  </nav>
</header>
