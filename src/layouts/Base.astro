---
import { u } from "@/site";
import "@/styles/global.css";
import { SITE, abs } from "@/site";
import Masthead from "@/components/Masthead.astro";
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/items/foo/". Defaults to the current path. */
  path?: string;
  /** JSON-LD objects for this page; the site graph is always added. */
  jsonLd?: Record<string, unknown>[];
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  /** Share card for og:image; defaults to the site card. Path relative to the site root. */
  image?: { path: string; alt: string; width: number; height: number };
  /** Headline for og:title and twitter:title, without the site name (og:site_name carries it). */
  socialTitle?: string;
  /** Longer than the 155-char meta description is fine here; unfurlers clip it themselves. */
  socialDescription?: string;
  section?: string;
  tags?: string[];
  /** Up to two label/value pairs that Slack shows under the unfurl (twitter:label1/data1). */
  labels?: { label: string; data: string }[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length) || "/",
  jsonLd = [],
  ogType = "website",
  publishedTime,
  modifiedTime,
  image = { path: "/og.png", alt: `${SITE.name}: ${SITE.tagline}`, width: 1200, height: 630 },
  socialTitle,
  socialDescription,
  section,
  tags = [],
  labels = [],
  noindex = false,
} = Astro.props;

// Keep the brand suffix while the whole title fits in a search result (~70 chars);
// past that, the full headline matters more than the brand.
const suffixed = title && `${title} | ${SITE.name}`;
const fullTitle = !title ? `${SITE.name}: AI security news, verified and explained` : suffixed!.length <= 70 ? suffixed! : title;
// Search results cut descriptions near 155 characters; end on a word.
const metaDescription = description.length > 155 ? description.slice(0, 154).replace(/\s+\S*$/, "") + "…" : description;
const canonical = abs(path);
// The Markdown twin of this page, for agents (see src/lib/markdown.ts).
const markdownPath = path === "/" ? "/index.md" : /^\/items\/[^/]+\/$/.test(path) ? path.replace(/\/$/, ".md") : null;
const ogImage = abs(image.path);
const ogTitle = socialTitle ?? fullTitle;
const ogDescription = socialDescription ?? metaDescription;

const siteGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": abs("/#org"),
      name: SITE.name,
      url: abs("/"),
      logo: abs("/favicon.svg"),
      image: abs("/og.png"),
      description: SITE.description,
      foundingDate: "2026",
      knowsAbout: ["AI security", "prompt injection", "AI agent security", "MCP security", "software supply chain security", "LLM jailbreaks"],
      ...(SITE.contactEmail
        ? { email: SITE.contactEmail, contactPoint: { "@type": "ContactPoint", contactType: "editorial", email: SITE.contactEmail, url: abs("/contact/"), availableLanguage: ["en"] } }
        : { contactPoint: { "@type": "ContactPoint", contactType: "editorial", url: `${SITE.feedbackUrl}/issues`, availableLanguage: ["en"] } }),
      sameAs: [SITE.feedbackUrl],
    },
    {
      "@type": "WebSite",
      "@id": abs("/#website"),
      name: SITE.name,
      url: abs("/"),
      description: SITE.description,
      publisher: { "@id": abs("/#org") },
      inLanguage: SITE.locale,
    },
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="icon" type="image/svg+xml" href={u("/favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={u("/rss.xml")} />
    <link rel="sitemap" href={u("/sitemap-index.xml")} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={u(markdownPath)} />}
    <link rel="alternate" type="application/feed+json" title={SITE.name} href={u("/feed.json")} />
    <meta name="theme-color" content="#0E1012" />
    <link rel="preconnect" href="https://cdn.prod.website-files.com" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image.alt} />
    {labels.slice(0, 2).flatMap((l, i) => [
      <meta name={`twitter:label${i + 1}`} content={l.label} />,
      <meta name={`twitter:data${i + 1}`} content={l.data} />,
    ])}

    <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {import.meta.env.PROD && SITE.analytics.websiteId && <Analytics />}
    <noscript><style>[data-blur-fade]{opacity:1!important;filter:none!important;transform:none!important}</style></noscript>
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-paper">Skip to content</a>
    <Masthead />
    <main id="main" class="mx-auto w-full max-w-7xl px-4 sm:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
